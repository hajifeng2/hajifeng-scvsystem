# 本地配置（含 token/路径，每人不同）
config.json

# 工作区产出（按职位分，本地 artifacts）
工作区/*
!工作区/.gitkeep

# PDF 提取产物
**/txt2/

# Python
__pycache__/
*.pyc

# Moka 抓取产出（in-folder 原始归档）
moka_output/

# Moka Edge profile（含登录态，不提交）+ 依赖
moka/.edge-auto/
moka/node_modules/

# 原始简历数据（体积大、含隐私，不提交）
resumes/

# 临时更新包
更新包_*/

# Claude Code 本地运行态/权限（每人不同，不提交）
.claude/settings.local.json
.claude/scheduled_tasks.lock

# 临时调试输出
_tmp_*
